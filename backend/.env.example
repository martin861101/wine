# Legacy standalone Node API configuration. Production uses backend/supabase.
NODE_ENV=development
PORT=4010

# Supabase Postgres connection string. DATABASE_URL is also accepted.
# Use the transaction pooler for serverless deployments and the session pooler
# for a long-running PM2/Node process.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-different-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGIN=http://127.0.0.1:5178
PUBLIC_APP_URL=http://127.0.0.1:5178

EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Wine & Chapters <hello@wineandchapters.co.za>

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Required only by the Supabase ai-chat Edge Function for live web research.
TAVILY_API_KEY=
PAYSTACK_SECRET_KEY=

STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Server-only secret. Never put this value in ui/.env or a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=event-photos
PUBLIC_STORAGE_URL=
